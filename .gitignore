# ── .NET build output ─────────────────────────────
bin/
obj/
[Bb]in/
[Oo]bj/
publish/
[Pp]ublish/
*.dll
*.pdb
# Zipped publish output — a build artifact; must NEVER be committed (it embeds appsettings.json
# with DB passwords + VAPID/JWT keys). Deploy uploads the publish/ folder to the server directly.
publish.zip
*.zip

# ── IDE / editor ──────────────────────────────────
.vs/
.idea/
*.user
*.suo
*.userprefs

# ── Runtime data (user uploads should NOT be in source control) ──
user-uploads/
Uploads/
wwwroot/uploads/

# ── Local secrets (uncomment the next line to keep DB passwords OUT of the repo) ──
# appsettings.Development.json

# ── Runtime logs (artifacts — never commit) ──────
debug_log.txt
*.log

# ── OS ────────────────────────────────────────────
Thumbs.db
.DS_Store
