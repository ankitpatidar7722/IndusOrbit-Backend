<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <!-- BulkImport (folded in): EPPlus = Excel import/export; JwtBearer = BulkImport auth -->
    <PackageReference Include="EPPlus" Version="7.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <!-- Ship the shared master Excel templates with every publish (seed data for the Template
       Master Excel tab). Runtime uploads/deletes still go to the deployed copy on the server;
       _deleted (soft-delete) files are not published. -->
  <ItemGroup>
    <Content Include="master-templates\**\*" Exclude="master-templates\_deleted\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship the generated "SOP of Web Modules" HTML docs with every publish. Must be Include (not
       Update): plain .html files are NOT part of the Web SDK's default Content glob, so Update found
       no items and the docs never reached publish/ — the server's SopModulesController then listed 0
       SOP docs (SOP Document column showed "—" for every module). Include adds them to Content. -->
  <ItemGroup>
    <Content Include="sop-web-modules\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
